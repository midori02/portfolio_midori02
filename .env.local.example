# お問い合わせメール送信（Gmail SMTP のみ）
#
# ※ next dev src のため .env.local は src/ 配下に置く
#
# 1. https://myaccount.google.com/security で 2段階認証 を有効化
# 2. 「アプリパスワード」で 16 文字のパスワードを発行
# 3. src/.env.local の SMTP_PASS に貼り付け
# 4. dev サーバーを再起動
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=midori00yabu@gmail.com
SMTP_PASS=

CONTACT_FROM_EMAIL=midori00yabu@gmail.com
CONTACT_TO_EMAIL=midori00yabu@gmail.com
