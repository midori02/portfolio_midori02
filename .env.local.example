# お問い合わせメール送信（Gmail SMTP）
#
# ローカル dev: next dev src のため src/.env.local に置く
# 本番 Vercel: Dashboard → Settings → Environment Variables（Production）に同じ 6 項目を設定
#
# 1. https://myaccount.google.com/security で 2段階認証 を有効化
# 2. 「アプリパスワード」で 16 文字のパスワードを発行
# 3. SMTP_PASS に貼り付け
# 4. dev サーバー再起動 / Vercel は Redeploy
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=midori00yabu@gmail.com
SMTP_PASS=

CONTACT_FROM_EMAIL=midori00yabu@gmail.com
CONTACT_TO_EMAIL=midori00yabu@gmail.com
